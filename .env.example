PORT=3000
PUBLIC_URL=

BITRIX_WEBHOOK_URL=
BITRIX_APP_TOKEN=

# Контур: только сделки (ONCRMDEALADD / ONCRMDEALUPDATE)
# Подстрока в TITLE сделки с формы Tilda «Реферальная программа»
REFERRAL_DEAL_TITLE_MATCH=Реферальная программа

# UF «email подтверждён» на контакте (не на сделке)
BITRIX_UF_EMAIL_CONFIRMED=UF_CRM_1787851781636
# UF чекбокс «Участник реферальной программы» на контакте
BITRIX_UF_REFERRAL_PARTICIPANT=UF_CRM_1787908414223
# UF ссылка «Реферальная ссылка» на контакте
BITRIX_UF_REFERRAL_LINK=UF_CRM_1787908433785
# Этап сделки после полной регистрации (Реферальная программа)
BITRIX_STAGE_AFTER_CONFIRM=UC_L2W4L1

TOKEN_SECRET=
TOKEN_TTL_HOURS=72

# info | debug (debug: все HTTP, Bitrix, SMTP + verify при старте)
LOG_LEVEL=info

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Для Gmail/Yandex: FROM = тот же ящик, что SMTP_USER, или настроенный алиас в Yandex
SMTP_FROM=

RULES_URL=

# Реферальная ссылка участника; {code} = ID контакта в Bitrix24
REFERRAL_LINK_TEMPLATE=https://avgst.ru/?ref={code}

# ---------------------------------------------------------------------------
# Ветка «День открытых дверей». Работает рядом с реферальной в том же
# приложении: сделка попадает сюда только по совпадению заголовка.
# ---------------------------------------------------------------------------

# Подстрока в TITLE сделки с формы Tilda (имя формы — tildaspec-formname)
EVENT_DEAL_TITLE_MATCH=Регистрация на день открытых дверей
# Этап сделки после подтверждения почты: «Регистрация на мероприятия»
EVENT_STAGE_AFTER_CONFIRM=UC_X25RZI

EVENT_DATE=2026-09-12
EVENT_START=10:00
EVENT_END=13:00
EVENT_UTC_OFFSET=3
EVENT_DATE_LABEL=суббота, 12 сентября 2026
EVENT_TIME_LABEL=сбор в 10:00

EVENT_ADDRESS=Нижний Новгород, ул. Зайцева, 31, корпус 1
EVENT_LANDMARK=проходная бывшего завода ЗКПД-4
EVENT_ROUTE_URL=https://yandex.ru/maps/?rtext=~56.366321,43.791390&rtt=auto
EVENT_LANDING_URL=https://avgst.ru/

# Показывается в письмах
EVENT_PHONE=+7 831 266-66-45

EVENT_REMINDER_SUBJECT=Завтра — День открытых дверей «Авангард Строй»
CONFIRM_DEDUPE_MINUTES=15
