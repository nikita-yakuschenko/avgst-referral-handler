PORT=3000
PUBLIC_URL=https://dev.avgst.ru/bitrix/referral

# Incoming webhook Bitrix24 (REST: crm.lead.update и т.д.)
BITRIX_WEBHOOK_URL=https://your.bitrix24.ru/rest/1/xxxxx/

# Исходящий webhook Bitrix24 → POST /webhook/bitrix (проверка токена приложения)
BITRIX_APP_TOKEN=

# Тип сущности: lead | deal
BITRIX_ENTITY_TYPE=lead

# UF чекбокса «Email подтверждён» — подставить когда пришлёте
BITRIX_UF_EMAIL_CONFIRMED=UF_CRM_XXXXX

# Стадия после подтверждения (опционально, STATUS_ID / STAGE_ID)
# BITRIX_STAGE_AFTER_CONFIRM=

# Подпись токена confirm-ссылки
TOKEN_SECRET=change-me-to-long-random-string
TOKEN_TTL_HOURS=72

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@avgst.ru

# Ссылки в письмах
RULES_URL=https://avgst.ru/referral
