PORT=3000
PUBLIC_URL=

BITRIX_WEBHOOK_URL=
BITRIX_APP_TOKEN=

# Контур: только сделки (ONCRMDEALADD / ONCRMDEALUPDATE)
# Подстрока в TITLE сделки с формы Tilda «Реферальная программа»
REFERRAL_DEAL_TITLE_MATCH=Реферальная программа

BITRIX_UF_EMAIL_CONFIRMED=
# UF чекбокс «Участник реферальной программы» на контакте
BITRIX_UF_REFERRAL_PARTICIPANT=UF_CRM_1787908414223
# UF ссылка «Реферальная ссылка» на контакте
BITRIX_UF_REFERRAL_LINK=UF_CRM_1787908433785
# Этап сделки после полной регистрации (Реферальная программа)
BITRIX_STAGE_AFTER_CONFIRM=UC_L2W4L1

TOKEN_SECRET=
TOKEN_TTL_HOURS=72

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

RULES_URL=

# Реферальная ссылка участника; {code} = ID контакта в Bitrix24
REFERRAL_LINK_TEMPLATE=https://avgst.ru/?ref={code}
